{
    "name": "Jupyter Devcontainer",
    "build": {
        "dockerfile": "../Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
    },
    "forwardPorts": [8888],
    "portsAttributes": {
        "8888": { "label": "Jupyter Notebook" }
    },
    "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt",
    "remoteEnv": {
        "TELRAAM_API_KEY": "${localEnv:TELRAAM_API_KEY}",
        "NEO4J_URI": "${localEnv:NEO4J_URI}",
        "NEO4J_USER": "${localEnv:NEO4J_USER}",
        "NEO4J_PASSWORD": "${localEnv:NEO4J_PASSWORD}"
    },
    "remoteUser": "root"
}
